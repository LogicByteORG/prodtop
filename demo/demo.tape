Output demo/demo.gif
Set Shell bash
Set Width 1100
Set Height 650
Set FontSize 15
Set Theme "Catppuccin Mocha"
Set Padding 12
Set TypingSpeed 60ms
Require ./bin/prodtop
Hide
Type "./bin/prodtop --config demo/prodtop.demo.yaml" Enter
Sleep 4s
Show
Sleep 1s
Type "2"
Sleep 2s
Type "3"
Sleep 2s
Type "/"
Sleep 0.5s
Type "order"
Sleep 0.5s
Enter
Sleep 2s
Escape
Sleep 0.5s
Type "4"
Sleep 2s
Type "i"
Sleep 0.5s
Type "SELECT email, plan FROM users LIMIT 5"
Sleep 0.5s
Enter
Sleep 2.5s
Escape
Sleep 0.5s
Type "5"
Sleep 2s
Ctrl+K
Sleep 1.5s
Escape
Sleep 0.5s
Type "q"
Sleep 1s
